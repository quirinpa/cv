.\" ============================== PROJECTS ==============================
.STACK_HEADER "THE PURE-C APPLICATION ENGINE STACK" \
  "A cohesive, zero-dependency software stack authored from scratch for high-concurrency web servers, isomorphic WASM applications, and specialized data engines. Zero external libraries, deterministic memory, sub-millisecond execution."

.CATEGORY "1. RUNTIME & CONCURRENCY"
.TS
tab(@);
lw(243p)2 lw(243p).
T{
.PCARD axil "HTTP / WS Server" "Event-driven HTTP(S), WebSocket and custom protocol daemon in plain C99. Single-threaded non-blocking I/O loop, zero dependencies, sub-millisecond routing." https://github.com/tty-pt/axil anchor
T}@T{
.PCARD libxylem "Dynamic Plugin Kernel" "Hook-based dynamic module system with runtime shared-library loading, dependency DAG resolution, lifecycle hooks, and strict ABI boundary enforcement." https://github.com/tty-pt/libxylem
T}
.TE

.CATEGORY "2. ISOMORPHIC UI & WASM FRAMEWORK"
.TS
tab(@);
lw(243p)2 lw(243p).
T{
.PCARD libbud "Isomorphic UI Compiler" "Dual-compilation reactive UI engine: compiles identical C code to native shared libraries for SSR and to browser WebAssembly for DOM hydration without JavaScript." https://github.com/tty-pt/libbud anchor
T}@T{
.PCARD "libbud-jsx" "Component Templating" "Declarative JSX-like macro dialect for pure C, enabling type-checked virtual DOM trees, ergonomic component composition, and single-pass HTML serialization." https://github.com/tty-pt/libbud
T}
.TE

.CATEGORY "3. HIGH-PERFORMANCE STORAGE & SPECIALIZED INDEXES"
.TS
tab(@);
lw(243p)2 lw(243p).
T{
.PCARD libcorm "In-Memory Struct DB" "Zero-copy in-memory struct database with secondary B-tree indexes, bidirectional relation mirrors, and instant disk persistence." https://github.com/tty-pt/libcorm anchor
T}@T{
.PCARD libhyle "Unified Schema Engine" "Single C struct schemas that automatically generate full-text search, multi-field filters, and sorted paginated views without SQL runtime overhead." https://github.com/tty-pt/libhyle
T}
T{
.PCARD libstoma "Accent-Sensitive FTS" "High-throughput full-text search tokenizer with accent folding (pão ≠ pao), n-gram indexing, and BM25-ranked retrieval in pure C." https://github.com/tty-pt/libstoma
T}@T{
.PCARD libjoint "Interval-Tree Engine" "Augmented interval-tree database managing complex temporal intervals, multi-dimensional time series, and spatial 'who, where, when' lookups." https://github.com/tty-pt/libjoint
T}
T{
.PCARD libsepal "Vector ANN Store" "Semantic vector database with two-stage Approximate Nearest Neighbor (ANN) search, SIMD-accelerated distance metrics, and vector quantization." https://github.com/tty-pt/libsepal
T}@T{
.PCARD libislet "3D Spatial Index" "Spatial indexing engine utilizing Morton space-filling curves and Z-order bounding boxes for lightning-fast 2D/3D spatial queries." https://github.com/tty-pt/libislet
T}
.TE

.CATEGORY "4. ACCELERATED COMPUTING, AI & GRAPHICS"
.TS
tab(@);
lw(243p)2 lw(243p).
T{
.PCARD libqllm "Vulkan Local LLM" "Zero-overhead local LLM inference engine running quantized transformer models and text embeddings directly on consumer GPUs via Vulkan compute shaders." https://github.com/tty-pt/libqllm anchor
T}@T{
.PCARD libqgl "Hardware 2D Graphics" "Lightweight, portable 2D rendering library with hardware rasterization, anti-aliased vector paths, and composable canvas operations." https://github.com/tty-pt/libqgl
T}
.TE

.RULE 3p 3p
.CATEGORY "CORE ARCHITECTURAL INVARIANTS"
.TS
tab(@);
lw(243p)2 lw(243p).
T{
.INVARIANT "Zero Dependencies" "Standalone C99/POSIX implementation without external runtimes, garbage collectors, or third-party packages." 3p
T}@T{
.INVARIANT "Deterministic Latency" "Sub-millisecond response times, zero-copy buffer passing, and fixed-footprint memory layout." 3p
T}
T{
.INVARIANT "Unified Isomorphism" "Shared C business logic dual-compiled to native server binaries (SSR) and client WebAssembly (WASM)."
T}@T{
.INVARIANT "Strict ABI Isolation" "Explicit XY module dependency DAGs, dynamic shared-library lifecycle hooks, and zero cross-module coupling."
T}
.TE
