.TE

.\" ============================== PROJECTS ==============================
.STACK_HEADER "SYSTEMS ARCHITECTURE & AUTONOMOUS AI STACK" \
  "A cohesive, zero-dependency software stack authored from scratch: from high-concurrency web servers and isomorphic WASM UI engines to local GPU LLM runtimes, vector databases, and autonomous AI agent harnesses."

.CATEGORY "1. RUNTIME & CONCURRENCY"
.TS
tab(@);
lw(243p)2 lw(243p).
T{
.PCARD axil "HTTP / WS Server" "Event-driven HTTP(S), WebSocket and custom protocol daemon in plain C99. Single-threaded non-blocking I/O loop, zero dependencies, sub-millisecond routing." https://github.com/tty-pt/axil anchor
T}@T{
.PCARD libxylem "Dynamic Plugin Kernel" "Hook-based dynamic module system with runtime shared-library loading, dependency DAG resolution, lifecycle hooks, and strict ABI boundary enforcement." https://github.com/tty-pt/libxylem
T}
.TE

.CATEGORY "2. ISOMORPHIC UI & 2D GRAPHICS"
.TS
tab(@);
lw(243p)2 lw(243p).
T{
.PCARD libbud "Isomorphic UI Engine" "Dual-compilation reactive UI compiler with declarative JSX templating for pure C: compiles identical code to native shared libraries for SSR and to browser WebAssembly for DOM hydration without JavaScript." https://github.com/tty-pt/libbud anchor
T}@T{
.PCARD libqgl "Hardware 2D Graphics" "Lightweight, portable 2D rendering library with hardware rasterization, anti-aliased vector paths, and composable canvas operations." https://github.com/tty-pt/libqgl
T}
.TE

.CATEGORY "3. RECALL KERNEL & SPECIALIZED STORAGE AXES"
.TS
tab(@);
lw(243p)2 lw(243p).
T{
.PCARD libcorm "In-Memory Struct DB" "Zero-copy in-memory struct database with secondary B-tree indexes, bidirectional relation mirrors, and instant disk persistence." https://github.com/tty-pt/libcorm anchor
T}@T{
.PCARD libhyle "Unified Schema Engine" "Single C struct schemas that automatically generate full-text search, multi-field filters, and sorted paginated views without SQL runtime overhead." https://github.com/tty-pt/libhyle
T}
T{
.PCARD libjoint "Interval-Tree Time Axis" "Canonical Time Axis: augmented interval-tree database managing complex temporal intervals, multi-dimensional time series, and spatial 'who, where, when' lookups." https://github.com/tty-pt/libjoint
T}@T{
.PCARD libislet "3D Spatial Space Axis" "Canonical Space Axis: multi-dimensional spatial indexing engine utilizing Morton space-filling curves and Z-order bounding boxes for lightning-fast 2D/3D spatial queries." https://github.com/tty-pt/libislet
T}
T{
.PCARD libsepal "Vector Meaning Axis" "Canonical Meaning Axis: vector database with two-stage Approximate Nearest Neighbor (ANN) search, SIMD distance metrics, and vector quantization." https://github.com/tty-pt/libsepal
T}@T{
.PCARD liblemma "Accent-Sensitive Text Axis" "Canonical Text Axis: high-throughput full-text search tokenizer with accent folding (pão ≠ pao), n-gram indexing, and BM25-ranked retrieval in pure C." https://github.com/tty-pt/liblemma
T}
.TE

.CATEGORY "4. LOCAL AI RUNTIMES & AUTONOMOUS AGENT HARNESSES"
.TS
tab(@);
lw(243p)2 lw(243p).
T{
.PCARD axil-auren "Vulkan LLM Engine" "High-throughput local LLM inference and vector embeddings daemon served as an axil module. Runs quantized GGUF models on consumer GPUs via Vulkan/Metal, powering zero-cost System One judging and dense vector search." https://github.com/tty-pt/axil-auren anchor
T}@T{
.PCARD pi-mm "Agent Memory Mipmaps" "Intelligent persistent memory engine for Pi coding agents. Combines libcorm struct storage with libsepal vector ANN search to autonomously inject relevant context before prompt execution and capture technical learnings on task settlement." https://github.com/tty-pt/pi-mm
T}
T{
.PCARD pi-quest "Epistemic Task Harness" "Autonomous quest journal and task governor for Pi coding agents. Enforces strict epistemic lifecycle gates \(em plan drafting, adversarial review passes, and deterministic validation \(em delivering reliable execution on complex multi-step objectives." https://github.com/tty-pt/pi-quest
T}@T{
.PCARD pi-early-compact "Context Governor" "Intelligent context compaction governor for Pi coding agents, enforcing adaptive threshold tiers, token headroom guards, and deterministic trimming before context collapse." https://github.com/tty-pt/pi-early-compact
T}
.TE

.RULE 3p 3p
.CATEGORY "CORE ARCHITECTURAL INVARIANTS"
.TS
tab(@);
lw(243p)2 lw(243p).
T{
.INVARIANT "Zero Dependencies" "Standalone C99/POSIX implementation without external runtimes, garbage collectors, or third-party packages." 3p
T}@T{
.INVARIANT "Deterministic Latency" "Sub-millisecond response times, zero-copy buffer passing, and fixed-footprint memory layout." 3p
T}
T{
.INVARIANT "Unified Isomorphism" "Shared C business logic dual-compiled to native server binaries (SSR) and client WebAssembly (WASM)."
T}@T{
.INVARIANT "Strict ABI Isolation" "Explicit XY module dependency DAGs, dynamic shared-library lifecycle hooks, and zero cross-module coupling."
T}
.TE
.FOOTER_LINK "https://github.com/quirinpa/cv"
